mixin informationTreeItem(title, titleIcon, leftBoxTitle, leftBoxContent, rightBoxTitle, rightBoxContent, rightBoxIcon=null, lastItem=null)
  -
    let leftBoxHolderBaseClass = "item-desc-holder border border-3 border-info rounded text-center"
    let rightBoxHolderBaseClass = "item-desc-holder border border-3 border-primary rounded"

    if (lastItem) {
      leftBoxHolderBaseClass += " bg-info text-white"
    } else {
      rightBoxHolderBaseClass += " bg-primary text-white"
    }
  div(class=`information-tree__item ${lastItem ? 'information-tree__item--last' : ''}`)
    dt.pill__heading.pill__heading--with-icon
      span.icon__with__circle
        img(src=titleIcon, width="87", alt="image description")
      = title
    dd
      .d-md-flex
        div(class=`col-md-6 information-tree__info d-flex flex-column justify-content-center align-items-center ${lastItem ? 'information-tree__info--first' : ''}`)
          span.item-title.bg-primary.text-white.rounded-pill.font-lg= leftBoxTitle
          div(class=leftBoxHolderBaseClass)
            .item-desc
              p= leftBoxContent
        .col-md-6.information-tree__info.d-flex.flex-column.justify-content-center.align-items-center
          span.item-title.bg-info.text-white.rounded-pill= rightBoxTitle
          div(class=rightBoxHolderBaseClass)
            span.icon
              if rightBoxIcon
                img(src=rightBoxIcon, width="81", alt="image description")
              else
                img(src="assets/images/icons/icon-shield-question.svg", width="81", alt="image description")
            .item-desc
              p= rightBoxContent