mixin sectionIntro(title, description, textColor='text-info')
  .row.justify-content-center.pt-md-3.pb-3.pb-md-5
    .col-md-10
      div.text-center.font-md-large.px-md-4_5
        h2(class=textColor)= title
        if description
          p= description
        else
          block

mixin descriptionText(verticalSpace='py-4_5')
  div(class=`text-center px-sm-4 px-md-8 ${verticalSpace}`)
    p.font-md-large
      block