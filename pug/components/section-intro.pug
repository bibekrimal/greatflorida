mixin sectionIntro(title, description, textColor='text-info')
  .row.justify-content-center.pt-md-3.pb-3.pb-md-5
    .col-md-10
      article.text-center.font-md-large.px-md-4_5
        h2(class=textColor)= title
        if description
          p= description
        else
          block

mixin descriptionText()
  .text-center.px-8.py-4_5
    p.font-md-large
      block