mixin twoColTextImg(image, title, alignment='default', description, overlayColor=null)
  -
    // Default Classes
    let imageColClass = 'col-md-6 order-md-1 d-flex justify-content-center justify-content-md-end'
    let contentColClass = 'col-md-6 text-center text-md-start'

    // Alignment Classes
    if (alignment === 'rightAligned') {
      imageColClass = 'col-md-6 d-flex justify-content-center justify-content-md-start'
      contentColClass = 'col-md-6 text-md-end'
    }

  .row.align-items-start.py-2.py-md-3
    div(class=imageColClass)
      div(class=`image-with-overlay rounded-lg mb-3 mb-md-0 ${overlayColor === 'blue' ? 'overlay--blue' : ''}`)
        img(src=image width="435" height="223" alt="image description")
    div(class=contentColClass)
      h2.text-info= title
      if description
        p= description
      else
        block