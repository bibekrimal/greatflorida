extends includes/layout.pug
include components/two-cols-text-image.pug
include components/section-intro.pug
include components/information-tree-item.pug
include components/full-width-section.pug
include components/card-with-image.pug
include components/compare-block.pug
include components/factors-article.pug
include components/talk-to-us.pug
include components/graphic-list.pug
block vars
  - var currentPage = "auto"
  
block content
  .intro.py-3.text-center.text-md-start
    .container
      +twoColTextImg(
        "assets/images/auto/img1.jpg",
        "Personal Auto Insurance",
        "leftAligned",
        "Your car represents freedom, protection, and convenience. However, a single collision or unexpected event can lead to overwhelming repair bills, medical expenses, or even legal costs. With GreatFlorida, you can protect both your vehicle and your finances. We partner with top-rated insurers to offer comprehensive coverage so you can drive confidently every day."
      )
      +twoColTextImg(
        "assets/images/auto/img2.jpg",
        "All Florida Drivers Must Carry Auto Insurance By Law",
        "rightAligned",
        "Florida is known for its high rate of traffic accidents. To legally register a vehicle in the state, drivers are required to carry a minimum auto insurance policy at all times. Without proof of valid coverage, you risk fines, license suspension, and exposure to high out-of-pocket costs in the event of an accident. This legal requirement makes it essential to choose a policy that not only meets the minimum but also provides real protection."
      )
  
  section.py-3
    .container
      +sectionIntro(
        "What Does Florida Auto Insurance Cover?",
        "Florida auto insurance policies are designed to protect you from a range of potential risks. While the legal minimum includes basic coverages, many drivers opt for additional options to secure extra peace of mind. Here’s a detailed look at what your policy can cover:"
      )
      dl.information-tree
        +informationTreeItem(
          "Bodily injury liability",
          "assets/images/auto/icons/icon1.svg",
          "Coverage:",
          "Pays for injuries to others if you’re at fault in an accident, including emergency services, hospital bills, and claims related to disability or wrongful death.",
          "Why It Matters:",
          "It protects you from the high costs associated with medical care and potential lawsuits."
        )
        +informationTreeItem(
          "Uninsured (and underinsured) motorist",
          "assets/images/auto/icons/icon3.svg",
          "Coverage:",
          "Protects you if you’re involved in an accident with a driver who either doesn’t have insurance or has insufficient coverage.",
          "Why It Matters:",
          "With a significant number of uninsured drivers in Florida, this coverage ensures you’re not left with exorbitant repair or medical bills."
        )
        +informationTreeItem(
          "Medical payments / no-fault / personal injury protection (pip)",
          "assets/images/auto/icons/icon4.svg",
          "Coverage:",
          "Covers the medical expenses for you and your passengers after an accident, regardless of who is at fault.",
          "Why It Matters:",
          "Florida law mandates PIP, ensuring prompt medical support when you need it most."
        )
        +informationTreeItem(
          "Property damage liability",
          "assets/images/auto/icons/icon5.svg",
          "Coverage:",
          "Pays for the cost of repairing or replacing another person’s property—such as vehicles, buildings, or road signs—that you may damage in an accident.",
          "Why It Matters:",
          "It shields you from financial liability and legal expenses resulting from property damage."
        )
        +informationTreeItem(
          "Comprehensive physical damage",
          "assets/images/auto/icons/icon6.svg",
          "Coverage:",
          "Covers non-collision events like theft, vandalism, car fire, weather-related damage, or falling objects.",
          "Why It Matters:",
          "It provides extra protection when your vehicle is affected by events beyond your control."
        )
        +informationTreeItem(
          "Collision coverage",
          "assets/images/auto/icons/icon7.svg",
          "Coverage:",
          "Pays for repairs or the replacement of your vehicle if it collides with another vehicle or object.",
          "Why It Matters:",
          "Essential if you cannot afford to replace your car out of pocket after an accident."
        )
        +informationTreeItem(
          "Additional services",
          "assets/images/auto/icons/icon8.svg",
          "Towing Services:",
          "Covers the cost of towing your vehicle after an accident or breakdown.",
          "Rental Car Reimbursement:",
          "Helps pay for a rental car while your vehicle is being repaired, so you’re never stranded.",
          "assets/images/auto/icons/icon9.svg",
          "lastItem"
        )
        
  +fullWidthSection(
    "assets/images/auto/img3.jpg",
    "Can I Still Get Coverage with a Record of Accidents, Speeding Tickets, or a DUI?",
    "bg-primary",
    null,
    "rightAligned",
    "Absolutely. At GreatFlorida, we understand that life happens. Even if your driving record isn’t spotless, our experienced agents work with specialized carriers to find a policy that meets your needs. We’re committed to helping drivers in every situation secure the coverage they deserve."
  )
  section.py-3
    .container
      +sectionIntro(
        "New in Florida? Know Your Auto Insurance Laws"
      )
        p Welcome to the Sunshine State! <br />Florida’s auto insurance laws are unique, and it’s important to understand them as a new resident:
      .row.gx-lg-2
        .col-sm-6.col-lg-3.d-flex.mb-4.mb-lg-0
          +cardWithImage(
            "assets/images/auto/img4.jpg",
            "assets/images/auto/icons/icon10.svg",
            "Florida No-Fault Law:",
            "blue",
            "Requires all drivers to carry Personal Injury Protection (PIP), ensuring that medical expenses are covered regardless of fault."
          )
        .col-sm-6.col-lg-3.d-flex.mb-4.mb-lg-0
          +cardWithImage(
            "assets/images/auto/img5.jpg",
            "assets/images/auto/icons/icon11.svg",
            "Florida Tag Requirement:",
            "orange",
            "New residents have 30 days to register their vehicle with the state."
          )
        .col-sm-6.col-lg-3.d-flex.mb-4.mb-lg-0
          +cardWithImage(
            "assets/images/auto/img6.jpg",
            "assets/images/auto/icons/icon12.svg",
            "Florida Insurance Requirement:",
            "blue",
            "You must carry proof of insurance at all times while driving."
          )
        .col-sm-6.col-lg-3.d-flex.mb-4.mb-lg-0
          +cardWithImage(
            "assets/images/auto/img7.jpg",
            "assets/images/auto/icons/icon13.svg",
            "Florida Financial Responsibility Law:",
            "orange",
            "Drivers with a history of serious accidents, repeated offenses, or DUIs may be required to carry full liability auto insurance."
          )
  section.bg-info.text-white.py-4
    .container
      h2.text-center Collision vs. Comprehensive: What’s the Difference?
      .row.position-relative
        .col-md-6.mb-4.mb-md-0.position-relative.position-md-static
          span.vs-divider
            img(src="assets/images/auto/icons/icon16.svg", alt="image description", width="80")
          .vs-block.bg-secondary.rounded-sm
            h3.h5.vs-block__title Collision Coverage:
            .border.border-3.border-primary.rounded-sm.d-flex.text-black.h-100
              .icon
                img(class="img-fluid", src="assets/images/auto/icons/icon14.svg", alt="image description", width="120", height="150")
              .pt-7.pe-3.pe-md-5.pe-lg-6
                p Protects your vehicle from damages resulting from an accident with another vehicle or object.
        .col-md-6
          .vs-block.vs-block--alt.bg-secondary.rounded-sm
            h3.h5.vs-block__title Comprehensive Coverage:
            .border.border-3.border-info.rounded-sm.d-flex.flex-row-reverse.text-black.h-100
              .icon
                img(class="img-fluid" src="assets/images/auto/icons/icon15.svg" alt="image description" width="120" height="150")
              .pt-7.ps-3.ps-md-5.ps-lg-6.text-end
                p Safeguards your vehicle against non-collision events such as theft, vandalism, fire, or weather-related incidents (including hurricane damage).
      .text-center.pt-3
        p.mb-0 Understanding the difference helps you choose the right protection for your vehicle.
  section.py-3.py-md-5.text-center
    .container
      +sectionIntro(
        "How Much is Car Insurance in Florida?",
        "Florida’s average auto insurance rate is approximately $1,878 per year—about 31.6% higher than the U.S. average. Several factors influence your premium:",
        "text-info"
      )
      .factors__section
        .grid
          .position-relative
            .connection__icon
              img(src="assets/images/icons/icon-dollar.svg", alt="image description", width="13")
            +factorsArticle(
              "Age",
              "Younger drivers, especially teenagers, generally face higher rates due to inexperience. For example, 16‑year-olds can see annual premiums around $5,983, while drivers over 50 might average about $1,640 per year.",
              "assets/images/auto/icons/icon17.svg"
            )
          .position-relative
            .connection__icon
              img(src="assets/images/icons/icon-dollar.svg", alt="image description", width="13")
            +factorsArticle(
              "MARITAL STATUS:",
              "Married couples and widows often pay lower premiums compared to single or divorced drivers.",
              "assets/images/auto/icons/icon18.svg"
            )
          .position-relative
            +factorsArticle(
              "DRIVING VIOLATIONS:",
              "A history of speeding tickets, accidents, or DUIs can result in higher premiums.",
              "assets/images/auto/icons/icon19.svg"
            )
          .position-relative
            .connection__icon
              img(src="assets/images/icons/icon-dollar.svg", alt="image description", width="13")
            +factorsArticle(
              "CREDIT SCORE:",
              "Drivers with higher credit scores typically benefit from lower rates.",
              "assets/images/auto/icons/icon20.svg"
            )
          .position-relative
            .connection__icon
              img(src="assets/images/icons/icon-dollar.svg", alt="image description", width="13")
            +factorsArticle(
              "GARAGING LOCATION:",
              "Where your vehicle is primarily parked or “garaged” plays a major role in determining your rate. Areas with high traffic density, elevated accident rates, or higher crime may lead to increased premiums, while safer neighborhoods can result in significant savings.",
              "assets/images/auto/icons/icon23.svg"
            )
          .position-relative
            +factorsArticle(
              "COVERAGE & DEDUCTIBLES:",
              "Opting for higher coverage limits and lower deductibles increases protection but may raise your premium.",
              "assets/images/auto/icons/icon21.svg"
            )
          .position-relative
            +factorsArticle(
              "YOUR AGENT:",
              "A knowledgeable local agent can help you navigate these factors to secure the best possible rate.",
              "assets/images/auto/icons/icon22.svg"
            )
  article.bg-info.text-white.overflow-hidden.pt-3.pt-md-0
    .container
      .row.justify-content-between
        .col-md-5.order-md-1.d-flex.justify-content-center.justify-content-md-end.position-relative
          .image-with-overlay.image-bleed.mb-3.mb-md-0
            img(class="img-fluid", src="assets/images/auto/img8.jpg", alt="image description", width="435", height="223")
        .col-md-6.font-md-large.text-center.text-md-start.py-3.py-md-5
          h2 What is the Minimum Required Auto Insurance Coverage in Florida?
          p To register a vehicle in Florida, drivers must carry at least:
          .information-box
            .icon
              img(class="img-fluid", src="assets/images/auto/icons/icon1.svg", alt="image description", width="87")
            span.font-md-large.font-weight-bold $10,000 in Personal Injury Protection (PIP)
          .information-box
            .icon
              img(class="img-fluid", src="assets/images/auto/icons/icon5.svg", alt="image description", width="87")
            span.font-md-large.font-weight-bold $10,000 in Property Damage Liability (PDL)
          p While these are the legal minimums, we recommend considering higher limits to better safeguard your finances against rising healthcare and repair costs
  section.py-3
    .container
      +sectionIntro(
        "Florida Car Insurance Frequently Asked Questions"
      )
      .graphic__list.faq__holder
        +graphicItem(
          "assets/images/auto/icons/icon24.svg",
          "What is a Deductible for Car Insurance?",
          "The deductible is the out-of-pocket amount you agree to pay when you file a claim before your insurance covers the rest. A higher deductible can lower your monthly premium.",
          "variant-blue"
        )
        +graphicItem(
          "assets/images/auto/icons/icon25.svg",
          "What are Florida Teen Driving Laws?",
          null,
          "variant-blue"
        )
          p Florida’s graduated licensing system helps teens gain driving experience safely:
            ul
              li 
                strong At 15: 
                | Eligible for a learner’s permit (with supervision and a required 50 hours of practice).
              li 
                strong At 16: 
                | Can obtain a full license with restrictions (e.g., driving hours).
              li 
                strong At 17: 
                | Certain curfew restrictions still apply until full privileges are granted at 18.
        +graphicItem(
          "assets/images/auto/icons/icon26.svg",
          "Why Buy Auto Insurance from a Local Agent?",
          "Local GreatFlorida agents know the Florida market inside and out. They work directly with top insurers to find competitive rates and personalized policies that fit your unique needs—providing support 24/7 without the frustration of faceless call centers.",
          "variant-blue"
        )
        +graphicItem(
          "assets/images/auto/icons/icon27.svg",
          "What Questions Should I Ask My Car Insurance Agent?",
          null,
          "variant-blue"
        )
          p Consider asking:
            ul
              li What discounts am I eligible for (student, good driver, multi-policy, etc.)?
              li What is the realistic cost to cover an accident based on my current finances?
              li Does the insurance company have a strong reputation for service?
              li Who do I contact to file a claim, and what is the process?
  +talkToUs(
    "assets/images/auto/img-hero.jpg",
    "Build Your Own Customized Florida Auto Insurance Policy",
    "Your life is unique—your insurance should be too. Work with us to create a bespoke policy that fits your lifestyle, budget, and coverage needs. Our agents compare policies and rates from top insurers, ensuring you get comprehensive protection at an affordable price."
  )