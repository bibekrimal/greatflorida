extends includes/layout.pug
include components/two-cols-text-image.pug
include components/section-intro.pug
include components/graphic-list.pug
include components/full-width-section.pug
include components/card-with-image.pug
include components/compare-block.pug
include components/talk-to-us.pug
block vars
  - var currentPage = "renters"
  
block content
  .intro.py-3.text-center.text-md-start
    .container
      +twoColTextImg(
        "assets/images/img29.jpg",
        "Renters Insurance",
        "leftAligned",
        "Your landlord can insure the structure of your home or apartment. But inside the walls is up to you. Your prized possessions and childhood collections can all be covered with a renters insurance policy in Florida. You can even spare yourself legal and medical costs if someone gets hurt in your home."
      )
      +twoColTextImg(
        "assets/images/img30.jpg",
        "How is Renters Insurance Different From Homeowners Insurance?",
        "rightAligned",
        "Homeowners insurance covers the structure of a property. But if you don't own your home, your belongings won't be covered from theft, fire, damage, or accidents. Renters insurance can even cover the cost of moving after a disaster."
      )
  
  section.py-3
    .container
      +sectionIntro(
        "What Does Renters Insurance Cover in Florida?",
        "If you rent, your space still needs protection from the unexpected. Whether you live in a house, condo, or apartment, renters insurance can cover you for:"
      )
      .graphic__list
        +graphicItem(
          "assets/images/icons/icon47.svg",
          "Liability",
          "If a visitor is injured in your home, you may be liable for legal, medical, and other costs. Renters insurance protects you and your guests from financial and relationship crisis.",
          "variant-blue"
        )
        +graphicItem(
          "assets/images/icons/icon48.svg",
          "Personal Property",
          "Thieves, fire and water damage don't care whether you rent or own. Protect your furniture, valuables, and appliances with a completely customized renters insurance policy.",
          "variant-blue"
        )
        +graphicItem(
          "assets/images/icons/icon49.svg",
          "Relocation Expenses",
          "An unexpected move is stressful, but it can also be expensive. Renters insurance policies can cover relocation expenses in the event of a disaster.",
          "variant-blue"
        )
  
  +fullWidthSection(
    "assets/images/img31.jpg",
    "If Someone is Hurt in My Home, Can Renters Insurance Help?",
    "bg-primary",
    null,
    "rightAligned",
    "Yes. Legal costs and medical bills can be devastating. But renters insurance provides the protection you need if someone gets hurt in your home. It also ensures your guests can get the crucial care they might need if they are injured in your home."
  )
  section.py-3
    .container
      +sectionIntro(
        "Will Renters Insurance Cover Damages to my Personal Belongings?",
        "Hope for the best but plan for the worst. Accidents happen and the unthinkable is always possible. Renters insurance covers the inside of your home and your personal belongings in case of:"
      )
      .row.gx-lg-2
        .col-sm-6.col-lg-3.d-flex.mb-4.mb-lg-0
          +cardWithImage(
            "assets/images/img32.jpg",
            "assets/images/icons/icon53.svg",
            "Accidental damage",
            "blue"
          )
        .col-sm-6.col-lg-3.d-flex.mb-4.mb-lg-0
          +cardWithImage(
            "assets/images/img33.jpg",
            "assets/images/icons/icon54.svg",
            "Accidental damage",
            "orange"
          )
        .col-sm-6.col-lg-3.d-flex.mb-4.mb-lg-0
          +cardWithImage(
            "assets/images/img34.jpg",
            "assets/images/icons/icon55.svg",
            "Accidental damage",
            "blue"
          )
        .col-sm-6.col-lg-3.d-flex.mb-4.mb-lg-0
          +cardWithImage(
            "assets/images/img35.jpg",
            "assets/images/icons/icon56.svg",
            "Accidental damage",
            "orange"
          )
      +descriptionText()
        span.d-md-block Florida is no stranger to natural disasters.
        | Your landlord's insurance will cover the structure of your home. But you need to protect the inside. Renter's insurance gives your family the best chance to start over after disaster strikes.
  section.py-3
    .container
      +sectionIntro(
        "Will Renters Insurance Cover Damages to my Personal Belongings?",
        "Hope for the best but plan for the worst. Accidents happen and the unthinkable is always possible. Renters insurance covers the inside of your home and your personal belongings in case of:",
        "text-primary"
      )
      .graphic__list
        +graphicItem(
          "assets/images/icons/icon50.svg",
          "What is a Deductible?",
          "A deductible is the amount you agree to pay out of pocket, before your insurance coverage kicks in. The higher the deductible you choose, the lower the premium you can expect. Talk to a GreatFlorida agent about finding the right balance for your policy."
        )
        +graphicItem(
          "assets/images/icons/icon51.svg",
          "What About Deductibles for Liability Claims?",
          "Your deductible is only applied to personal property claims. In the event of a liability claim, you are covered with a renters insurance policy from a GreatFlorida Insurance partner."
        )
        +graphicItem(
          "assets/images/icons/icon52.svg",
          "Are There Exceptions to Deductibles?",
          "In Florida, hurricane damage comes with separate coverage and deductible agreements. Talk to your GreatFlorida Insurance agent about the best protection and deductible options for hurricanes."
        )
  +compareBlock(
    "Flexible Payment Plans For You to Choose From",
    "Payment options that work for you.",
    "assets/images/img36.jpg",
    "One Time Payment",
    "Save like a champ. Our one time payment options are the most cost effective way to get renters insurance in Florida.",
    "assets/images/img37.jpg",
    "Quarterly Installments",
    "Need to budget? We've got you. Our quarterly installment plans make it easy to stay protected."
  )
  +talkToUs(
    "assets/images/img-hero4.jpg",
    "Build a Customized <br>Renters Insurance Policy Today",
    "The beauty of a customized policy: You only pay for what you really need. <br>Take an inventory of your belongings, then call your GreatFlorida agent for a custom quote. We can match you to the ideal policy in minutes, accounting for everything you own. It might surprise you how much value is in your home. Protect it with low cost and high quality renters insurance today."
  )